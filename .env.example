# Copy this file to ".env" (or ".env.local") and fill in your own values.
# Never commit the real file: .gitignore already excludes it.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# For local use, create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional settings (uncomment to change the defaults):
# GEMINI_MODEL="gemini-4-hydrogen"   # which Gemini model the tutor uses
# PORT=3000                          # port the local server listens on
# HOST="127.0.0.1"                   # set this to keep the server private to this computer
